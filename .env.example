# Cloudflare Turnstile — pobierz klucze z https://dash.cloudflare.com → Turnstile
# VITE_ prefix = widoczne w przeglądarce (site key)
VITE_TURNSTILE_SITE_KEY=your_site_key_here
# Bez VITE_ = tylko serwer (secret key). WYMAGANY dla rejestracji: bez niego /api/register odmawia (503).
# Lokalnie można użyć kluczy testowych Cloudflare: sekret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=your_secret_key_here

# GUS BIR 1.1 — klucz do wyszukiwania firm po NIP/REGON (rejestr REGON)
# Klucz testowy: abcde12345abcde12345 | Produkcyjny: https://api.stat.gov.pl/Home/RegonApi
GUS_API_KEY=your_gus_api_key_here

# Adres publicznego formularza APK (trasa /form). Domyślnie https://portal.beautypolisa.eu/form
# VITE_APK_FORM_URL=https://portal.beautypolisa.eu/form

# Odnowienia OC beauty (wszystkie opcjonalne — poniżej wartości domyślne)
# Nadawca e-maili do klientów (domena musi być zweryfikowana w Resend firmy):
# RENEWAL_EMAIL_FROM=BeautyPolisa <odnowienia@beautypolisa.eu>
# Skrzynka biura: kopia każdego wniosku z PDF i załącznikami, adres „odpowiedz do” dla klientów:
# RENEWAL_OFFICE_EMAIL=odnowienia@auraexpert.pl
# Adres serwisu w linkach do wniosku (domyślnie adres, z którego przyszło żądanie):
# RENEWAL_LINK_BASE=https://portal.beautypolisa.eu
# Sekret podpisu linków (domyślnie wyprowadzany z SUPABASE_SERVICE_ROLE_KEY; zmiana unieważnia wysłane linki):
# RENEWAL_LINK_SECRET=
# Tryb testowy odnowień (moduł „odnowienia_test” w SAAS Admin): wszystkie e-maile odnowień na ten adres:
# RENEWAL_TEST_EMAIL=zarzad@auraexpert.pl
